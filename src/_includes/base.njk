<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="robots" content="noindex, nofollow">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ site.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;600;700&family=Noto+Sans+Georgian:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="styles.css?v={{ build.v }}">
<style>.logo{gap:12px}.logo .lg-bar{height:30px}.logo .lg-kaen{gap:3px;margin-left:0}.logo .lg-kaen span:first-child{font-size:1.02rem}.logo .lg-kaen span:last-child{font-size:.68rem;letter-spacing:.3em}@media (max-width:400px){.logo{gap:9px}.logo .lg-nvc{font-size:1.5rem}.logo .lg-kaen span:first-child{font-size:.9rem}.logo .lg-kaen span:last-child{font-size:.6rem}}</style>
</head>
<body>
<nav>
  <div class="nav-in">
    <a href="index.html" class="logo" aria-label="NVC Georgia — NVC საქართველო"><span class="lg-nvc">NVC</span><span class="lg-bar"></span><span class="lg-kaen"><span lang="ka">საქართველო</span><span>GEORGIA</span></span></a>
    <ul class="menu" id="menu">
{%- for item in site.menu %}{% set n = nav[loop.index0] or {} %}
      <li><a href="{{ n.url or item.url }}"{% if n.page and n.page == active %} class="on"{% endif %} data-ka="{{ item.label.ka or item.label.en }}">{{ item.label.en | safe }}</a></li>
{%- endfor %}
    </ul>
    <div style="display:flex;gap:12px;align-items:center">
      <div class="lang" role="group" aria-label="Language">
        <button class="on" data-lang="en">EN</button><button data-lang="ka">ქარ</button>
      </div>
      <button class="burger" aria-label="Menu">☰</button>
    </div>
  </div>
</nav>
{{ content | safe }}
<footer id="site-footer">
  <span>{{ site.name }}</span>
  {%- if site.contact.en %}
  <span data-ka="{{ site.contact.ka or site.contact.en }}">{{ site.contact.en | safe }}</span>
  {%- endif %}
</footer>
{% if site.draft_notice.show %}
<div class="mock" data-ka="{{ site.draft_notice.ka }}">{{ site.draft_notice.en | safe }}</div>
{% endif %}
<script src="app.js?v={{ build.v }}"></script>
</body>
</html>
