---
layout: base.njk
title: Home
active: Home
permalink: index.html
---
{%- from "t.njk" import attr -%}
{%- set h = home.hero -%}
<header class="hero" id="top">
  <div class="wash w1"></div><div class="wash w2"></div><div class="wash w3"></div><div class="wash w4"></div>
  <div class="hero-split">
    <div class="hero-body">
      <div class="eyebrow"{{ attr(h.eyebrow) }}>{{ h.eyebrow.en | safe }}</div>
      <h1 data-ka="{{ h.title_line_1.ka }}<br><b>{{ h.title_line_2.ka }}</b>">{{ h.title_line_1.en | safe }}<br><b>{{ h.title_line_2.en | safe }}</b></h1>
      <p class="lead"{{ attr(h.lead) }}>{{ h.lead.en | safe }}</p>
      <div class="btns">
        <a href="#contact" class="btn p"{{ attr(h.button_contact) }}>{{ h.button_contact.en | safe }}</a>
        <a href="#about-nvc" class="btn s"{{ attr(h.button_about) }}>{{ h.button_about.en | safe }}</a>
      </div>
    </div>
    <div class="hero-photo"><img src="{{ h.photo }}" alt="{{ h.photo_alt }}"></div>
  </div>
</header>
{% set a = home.about %}
<section class="block nvc" id="about-nvc">
  <div class="wrap nvc-grid">
    <div>
      <div class="kicker"{{ attr(a.kicker) }}>{{ a.kicker.en | safe }}</div>
      <h2{{ attr(a.heading) }}>{{ a.heading.en | safe }}</h2>
      <p class="sub nvc-l"{{ attr(a.text_left) }}>{{ a.text_left.en | safe }}</p>
    </div>
    <div>
      <p class="sub nvc-r"{{ attr(a.text_right) }}>{{ a.text_right.en | safe }}</p>
      {%- if a.link_url %}
      <a href="{{ a.link_url }}" class="more nvc-link" target="_blank" rel="noopener"{{ attr(a.link_text) }}>{{ a.link_text.en | safe }}</a>
      {%- endif %}
      <a href="materials.html#learn" class="big-cta nvc-cta">
        <span{{ attr(a.materials_button) }}>{{ a.materials_button.en | safe }}</span>
        <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
{% set w = home.who %}
<section class="block" id="team">
  <div class="wrap">
    <a href="team.html" class="group wide"><img src="{{ w.photo }}" alt="{{ w.photo_alt }}"></a>
    <div class="team-under">
      <div>
        <div class="kicker"{{ attr(w.kicker) }}>{{ w.kicker.en | safe }}</div>
        <h2{{ attr(w.heading) }}>{{ w.heading.en | safe }}</h2>
      </div>
      <div>
        <p class="sub"{{ attr(w.text) }}>{{ w.text.en | safe }}</p>
        <a href="team.html" class="mat-cta team-cta">
          <span class="avatars">{% for p in collections.team %}<img src="{{ p.data.photo }}" alt="">{% endfor %}<i></i></span>
          <span class="mat-cta-body">
            <span class="kicker"{{ attr(w.card_kicker) }}>{{ w.card_kicker.en | safe }}</span>
            <b{{ attr(w.card_title) }}>{{ w.card_title.en | safe }}</b>
            <span class="more"{{ attr(w.card_link) }}>{{ w.card_link.en | safe }}</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="block" id="latest" style="padding-top:20px">
  <div class="wrap">
    <div class="latest-head">
      <div>
        <h2 style="margin:0"{{ attr(home.news_heading) }}>{{ home.news_heading.en | safe }}</h2>
      </div>
      <div class="arrows"><button aria-label="Previous" onclick="rail(-1)">←</button><button aria-label="Next" onclick="rail(1)">→</button></div>
    </div>
    <style>.rail .post .poster.photo{background-size:cover !important;background-position:center !important}</style>
    <div class="rail" id="rail">
{%- for n in collections.news %}{% set d = n.data %}
      <article class="post">{% if d.card.href %}<a href="{{ d.card.href }}" target="_blank" rel="noopener">{% endif %}<div class="poster{% if d.card.picture %} photo{% endif %}"{% if d.card.picture %} style="background-image:url('{{ d.card.picture }}')"{% endif %}{{ attr(d.title) }}>{{ d.title.en | safe }}</div>{% if d.card.href %}</a>{% endif %}<div class="post-body">{% if d.example %}<span class="ex" data-ka="მაგალითი">Example</span>{% endif %}<span class="tag"{{ attr(d.kind) }}>{{ d.kind.en | safe }}</span><span class="date"{{ attr(d.when) }}>{{ d.when.en | safe }}</span></div></article>
{%- endfor %}
    </div>
  </div>
</section>

{% set c = home.contact %}
<style>
.cf-wrap{max-width:560px;margin:0 auto}
.cf-wrap h2{margin:0 0 6px;text-align:center}
.cf-wrap .sub{text-align:center;margin:0 0 22px}
.cf{display:grid;gap:14px;background:#fff;border:1px solid var(--line);border-radius:24px;padding:24px}
.cf label{display:grid;gap:6px;font-weight:600;font-size:.9rem;color:var(--ink)}
.cf input,.cf textarea{font:inherit;font-weight:400;padding:11px 14px;border:1.5px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink)}
.cf input:focus,.cf textarea:focus{outline:none;border-color:var(--blue-deep);background:#fff}
.cf textarea{min-height:120px;resize:vertical}
.cf .btn{justify-self:start;border:0;cursor:pointer}
.cf .hp{position:absolute;left:-9999px}
.cf-msg{margin:0;font-weight:600}
.cf-msg.ok{color:var(--green-deep)} .cf-msg.err{color:#b24a3a}
</style>
<section class="block" id="contact">
  <div class="wrap cf-wrap">
    <h2{{ attr(c.heading) }}>{{ c.heading.en | safe }}</h2>
    {%- if c.intro.en %}<p class="sub"{{ attr(c.intro) }}>{{ c.intro.en | safe }}</p>{% endif %}
    <form class="cf" id="cf" method="POST" action="{{ c.form_action }}">
      <label><span{{ attr(c.label_name) }}>{{ c.label_name.en | safe }}</span><input name="name" type="text" required autocomplete="name"></label>
      <label><span{{ attr(c.label_email) }}>{{ c.label_email.en | safe }}</span><input name="email" type="email" required autocomplete="email"></label>
      <label><span{{ attr(c.label_message) }}>{{ c.label_message.en | safe }}</span><textarea name="message" required></textarea></label>
      <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn p" type="submit"{{ attr(c.button) }}>{{ c.button.en | safe }}</button>
      <p class="cf-msg" id="cf-msg" role="status" hidden data-ok-en="{{ c.thanks.en }}" data-ok-ka="{{ c.thanks.ka or c.thanks.en }}" data-err-en="{{ c.error.en }}" data-err-ka="{{ c.error.ka or c.error.en }}"></p>
    </form>
  </div>
</section>
<script>
(function(){
  var f=document.getElementById('cf'), m=document.getElementById('cf-msg');
  if(!f) return;
  function show(kind){var ka=document.documentElement.lang==='ka';m.textContent=m.dataset[kind+(ka?'Ka':'En')];m.className='cf-msg '+(kind==='ok'?'ok':'err');m.hidden=false;}
  f.addEventListener('submit',function(e){
    e.preventDefault();
    if(!f.getAttribute('action')){show('err');return;}
    fetch(f.action,{method:'POST',body:new FormData(f),headers:{'Accept':'application/json'}})
      .then(function(r){if(r.ok){f.reset();show('ok');}else{show('err');}})
      .catch(function(){show('err');});
  });
})();
</script>
